{
  "name": "@better-buy/web",
  "private": true,
  "scripts": {
    "predev": "pnpm --filter @better-buy/shared build",
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "build": "next build",
    "build:worker": "cross-env CLOUDFLARE_WORKER=1 next build",
    "start": "next start -H 127.0.0.1 -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@better-buy/shared": "workspace:*",
    "@types/leaflet": "^1.9.22",
    "better-auth": "^1.6.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "next": "^15.4.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-leaflet": "^5.0.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.17.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "cross-env": "^7.0.3",
    "tailwindcss": "^4.3.3",
    "vitest": "^3.2.4"
  }
}
