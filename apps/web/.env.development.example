# Local split-dev: the web app (Next on :3000) calls the Worker API directly on :8787.
# Copy to `.env.development` (NOT `.env.local`) so production `next build` stays same-origin.
# Deployed builds leave these unset so everything is same-origin behind the Worker.
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8787
NEXT_PUBLIC_AUTH_BASE_URL=http://127.0.0.1:8787
