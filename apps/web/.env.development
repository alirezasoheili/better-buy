# Local split-dev only (loaded by `next dev`): the web app (Next on :3000) calls the Worker API directly on :8787.
# Production builds (`next build`) do NOT load this file, so NEXT_PUBLIC_* stays unset and
# everything is same-origin behind the deployed Worker (https://better-buy.better-buy-worker.workers.dev).
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8787
NEXT_PUBLIC_AUTH_BASE_URL=http://127.0.0.1:8787
