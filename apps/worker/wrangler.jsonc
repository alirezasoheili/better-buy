{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "better-buy",
  "main": "src/entry.ts",
  "compatibility_date": "2026-08-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "workflows": [
    {
      "name": "better-buy-scan",
      "binding": "SCAN_WORKFLOW",
      "class_name": "ScanWorkflow",
    },
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "routes": [{ "pattern": "better-buy.ir", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "better-buy",
      "database_id": "c1f1e523-5f4e-4ac3-8f70-a2d35d539368",
      "migrations_dir": "migrations",
    },
  ],
  "assets": {
    "directory": "../web/out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/healthz"],
    "not_found_handling": "single-page-application",
  },
  "vars": {
    "APP_ORIGIN": "https://better-buy.ir",
    "BETTER_AUTH_URL": "https://better-buy.ir",
    "CORS_ORIGIN": "https://better-buy.ir",
    "DEV_MODE": "false",
    "SNAPP_STORE_CAMPAIGNS_ENABLED": "true",
    "SCAN_WORKFLOW_ENABLED": "false",
    "SCAN_WORKFLOW_CONCURRENCY": "1",
    "API_RATE_LIMITS_ENABLED": "true",
    "WISHLIST_SCHEDULE_ENABLED": "true",
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
}
