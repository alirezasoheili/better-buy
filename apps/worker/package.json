{
  "name": "@better-buy/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @better-buy/shared build",
    "dev": "wrangler dev --compatibility-date 2026-08-08",
    "build:web": "pnpm --filter @better-buy/shared build && pnpm --filter @better-buy/web build:worker",
    "deploy": "pnpm run build:web && wrangler deploy",
    "pretest": "pnpm --filter @better-buy/shared build",
    "test": "vitest run",
    "typecheck": "wrangler types ./src/env.d.ts && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@better-buy/shared": "workspace:*",
    "better-auth": "^1.6.26",
    "hono": "^4.9.2",
    "zod": "^4.0.14",
    "effect": "4.0.1"
  },
  "devDependencies": {
    "@better-auth/utils": "^0.4.2",
    "@types/node": "^22.17.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.120.0"
  }
}
