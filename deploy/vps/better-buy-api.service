[Unit]
Description=Better Buy Go API and scan queue
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=better-buy
Group=better-buy
WorkingDirectory=/srv/better-buy/current/apps/api
EnvironmentFile=/etc/better-buy/better-buy.env
ExecStart=/usr/local/bin/better-buy-api
Restart=on-failure
RestartSec=3
KillMode=control-group
TimeoutStopSec=15s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/better-buy
UMask=0077
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
