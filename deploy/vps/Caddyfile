better-buy.ir {
	encode zstd gzip

	@api path /api/* /healthz
	handle @api {
		reverse_proxy 127.0.0.1:8787 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle {
		@serviceWorker path /sw.js
		header @serviceWorker Cache-Control "no-cache"

		@nextStatic path /_next/static/*
		header @nextStatic Cache-Control "public, max-age=31536000, immutable"

		root * /srv/better-buy/current/apps/web/out
		try_files {path} {path}/index.html /index.html
		file_server
	}
}
