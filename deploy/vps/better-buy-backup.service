[Unit]
Description=Better Buy SQLite backup
After=better-buy-api.service

[Service]
Type=oneshot
User=better-buy
Group=better-buy
WorkingDirectory=/srv/better-buy/current/apps/api
EnvironmentFile=/etc/better-buy/better-buy.env
Environment=VPS_BACKUP_DIR=/var/backups/better-buy
Environment=VPS_BACKUP_RETENTION_DAYS=14
ExecStart=/usr/local/bin/better-buy-backup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/better-buy /var/backups/better-buy
UMask=0077
